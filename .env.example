# ==============================================================================
# AssetFlow - Environment Configuration Template
# ==============================================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกข้อมูล API Keys จาก Supabase และ Cloudinary

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (ฐานข้อมูล Real-time บน Cloud)
# ------------------------------------------------------------------------------
# รับค่าได้ที่: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Cloudinary Configuration (ที่เก็บรูปภาพฟรีบน Cloud)
# ------------------------------------------------------------------------------
# รับค่าได้ที่: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
